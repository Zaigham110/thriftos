# Copy to .env (never commit it). Used by docker compose.
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-text
# The shop opens http://<this computer>:8080 in the browser.
POS_PORT=8080

# Only for the https profile: the name the shop's devices open, for example shop.example.com.
POS_DOMAIN=
# For a name that exists only on the shop network, use: POS_HTTPS_FLAGS=--internal-certs
POS_HTTPS_FLAGS=
