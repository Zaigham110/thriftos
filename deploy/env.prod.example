# Template for /opt/thriftos/.env.prod on the production server. Never commit the real file.
# Generate secrets ON THE SERVER, e.g.:  openssl rand -base64 48
# (This replaces the old JWT_SECRET and DB password that are in git history.)

# Domain the app is served on (Caddy gets the HTTPS certificate for it) and the address for Let's Encrypt notices.
APP_DOMAIN=app.example.com
ACME_EMAIL=owner@example.com

# Release to run (set by the deploy pipeline; edit by hand only to roll back).
THRIFTOS_TAG=v0.0.0

POSTGRES_USER=thriftos
POSTGRES_DB=thriftos
POSTGRES_PASSWORD=generate-on-the-server

JWT_SECRET=generate-on-the-server
JWT_ACCESS_EXPIRES_IN=900s

# Only the app's own address may call the API from a browser.
CORS_ORIGIN=https://app.example.com
# Public bill links shared on WhatsApp point here.
PUBLIC_APP_URL=https://app.example.com

# 1 = apply new migrations when the API container starts (normal for production).
RUN_MIGRATIONS_ON_START=1
