# Template for /opt/thriftos/.env.prod on the production server. Never commit the real file.
# deploy/server-setup.sh creates it with fresh secrets (openssl rand) the first time; keep it 0600.
# (The new JWT_SECRET and DB password replace the old ones that are in git history.)

# Release to run (written by deploy/deploy.sh; edit by hand only to roll back).
THRIFTOS_TAG=v0.0.0

POSTGRES_USER=thriftos
POSTGRES_DB=thriftos
POSTGRES_PASSWORD=generate-on-the-server

JWT_SECRET=generate-on-the-server
JWT_ACCESS_EXPIRES_IN=900s

# CloudFront sends this in X-Origin-Verify; Caddy refuses requests without it.
ORIGIN_SECRET=generate-on-the-server

# The app's public address (CloudFront), with the /thriftos path.
CORS_ORIGIN=https://dXXXXXXXXXXXXX.cloudfront.net
PUBLIC_APP_URL=https://dXXXXXXXXXXXXX.cloudfront.net/thriftos

# 1 = apply new migrations when the API container starts (normal for production).
RUN_MIGRATIONS_ON_START=1
