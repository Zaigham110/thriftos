 "legal": {
  "privacy": {
   "p1": "What is kept: your business details; your users (name, email or phone); the customers and suppliers you add (name, WhatsApp number, city, balances); stock, sales and payments; and payment screenshots you upload.",
   "p2": "Why: only to run ThriftOS for your business — showing your records, the bills and reminders you choose to send on WhatsApp, and keeping the app working and safe.",
   "p3": "Who sees it: the people in your business you give access to, and the ThriftOS operator when you ask for help. Your data is not sold or shared. WhatsApp messages go from your own phone.",
   "p4": "Where: on a server in Australia (Amazon Web Services, Sydney), delivered through Amazon CloudFront over HTTPS. Server logs and error reports hold no names, phone numbers or amounts.",
   "p5": "How long: as long as your business uses ThriftOS. You can download everything at any time; ask the operator to delete your business when you leave.",
   "p6": "Questions or a request to correct or delete something: ask the person who set up ThriftOS for you.",
   "title": "Privacy"
  },
  "terms": {
   "p1": "ThriftOS is software for running a used-clothing business: stock, sorting, sales, khata and reports. These terms apply when you or your staff use it.",
   "p2": "Your data is yours. You can download all of it at any time from Settings → Download all my data, and you keep it if you stop using ThriftOS.",
   "p3": "You are responsible for the people you give access to, for keeping passwords and PINs private, and for checking amounts and balances before you act on them.",
   "p4": "We keep the service running as well as we can, but we cannot promise it will never be unavailable. Keep your own copy of important records.",
   "p5": "Do not use ThriftOS for anything unlawful, or to keep other people's details without their permission.",
   "p6": "We may change these terms; the date below changes when we do. Questions: ask the person who set up ThriftOS for you.",
   "title": "Terms of use"
  },
  "updated": "Last updated: 3 November 2026"
 },
