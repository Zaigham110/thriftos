{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**"
  ],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js",
          "/i18n/*.json",
          "/media/*.woff2"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/media/**",
          "/*.(svg|png|jpg|webp|woff|ttf)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "reference-data",
      "urls": [
        "/api/me",
        "/api/tenant",
        "/api/tenant/**",
        "/api/procurement/vendors**",
        "/api/procurement/rags**",
        "/api/procurement/containers**",
        "/api/sorting/*/queue**",
        "/api/sorting/*/summary**",
        "/api/sorting/*/sessions/**",
        "/api/stock/items**",
        "/api/stock/bales**",
        "/api/customers**",
        "/api/khata**",
        "/api/sales/last-price**",
        "/api/home/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "4s"
      }
    }
  ]
}
