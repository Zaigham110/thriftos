{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**", "!/api/**"],
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/icons/**", "/media/**", "/i18n/**", "/*.(svg|png|jpg|webp|woff|woff2|ttf)"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "reference-data",
      "urls": [
        "/api/me",
        "/api/tenant/settings",
        "/api/tenant/categories",
        "/api/tenant/grades",
        "/api/tenant/waste-categories",
        "/api/procurement/vendors**",
        "/api/procurement/rags**",
        "/api/customers**",
        "/api/stock/items**",
        "/api/khata**",
        "/api/home/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 200,
        "maxAge": "7d",
        "timeout": "4s"
      }
    }
  ]
}
