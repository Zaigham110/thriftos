// =============================================================
// 🔥 ThriftOS V3 - Complete Prisma Schema
// =============================================================
// Generated from: docs/architecture/thriftos-v3-architecture.md
// =============================================================

generator client {
  provider = "prisma-client-js"
}

generator serverClient {
  provider = "prisma-client-js"
  output   = "../server/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// 🧩 ENUMS
// =============================================================

enum VendorType {
  SUPPLIER
  FREIGHT_CARRIER
  PACKAGING_SUPPLIER
  EQUIPMENT_VENDOR
  SERVICE_PROVIDER
  CUSTOMER
  SHIPPER
  CONSIGNEE
  OTHER
}

enum PurchaseOrderType {
  CONTAINER
  LOOSE_BALE
  HYBRID
}

enum PurchaseOrderStatus {
  OPEN
  RECEIVED
  CLOSED
}

enum ContainerStatus {
  IN_TRANSIT
  ARRIVED
  CLEARED
  CLOSED
}

enum ChargeType {
  CIF // Kept for old data; new containers use Container.purchaseCost
  FREIGHT
  DUTY
  TAX
  CLEARING
  PORT_HANDLING
  TRANSPORT
  LABOUR
  MISC
}

enum SortStatus {
  OPEN
  CLOSED
}

enum GradeStatus {
  OPEN
  CLOSED
}

enum UnitType {
  KG_BALE
  PCS_PACK
  MIXED_BALE
}

enum RepackStatus {
  DRAFT
  READY
  SEALED
  SOLD
  RESERVED
}

enum RepackSessionStatus {
  OPEN
  CLOSED
}

enum MeasurementType {
  WEIGHT
  QUANTITY
}

// =============================================================
// 💰 SALES DOMAIN (Phase 1)
// =============================================================

enum SaleType {
  LOCAL
  WHOLESALE
  EXPORT
}

/// How the customer paid at the time of sale: all now, nothing now (udhaar), or part now.
enum PaymentMode {
  CASH
  CREDIT
  PARTIAL
}

enum SaleStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  RAAST
  JAZZCASH
  EASYPAISA
  OTHER
}

enum FulfillmentStatus {
  PENDING
  FULFILLED
}

// =============================================================
// 🗑️ WASTE (Tenant-configured categories + line items)
// =============================================================

enum WasteUnitType {
  KG
  PCS
}

enum WasteStage {
  STAGE_1
  STAGE_2
}

enum AllocationMode {
  FIFO
  MANUAL
}

enum GradingOutputStatus {
  AVAILABLE
  PARTIALLY_USED
  DEPLETED
  READY_FOR_REPACK
}

enum MovementType {
  INTAKE
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  EXPORT
}

/// Where a stock item came from: made here from sorted stock, or bought ready to sell.
enum StockSource {
  PROCESSED
  PURCHASED
}

/// How a stock item is counted and sold.
enum StockUnit {
  KG
  BALE
  PIECE
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum TenantStatus {
  ACTIVE
  INACTIVE
}

enum SequenceScope {
  PURCHASE_ORDER
  CONTAINER
  RAG
  SALE
}

// =============================================================
// 🔁 RAG/BALE STATUS & SOURCE ENUMS (Phase 2.5)
// =============================================================
// Rag lifecycle: NOT_STARTED → IN_SORTING → SORTED
// This ensures one-time processing per Rag/Bale

enum RagStatus {
  NOT_STARTED // Available for sorting selection
  IN_SORTING // Currently being processed - locked
  SORTED // Permanently closed - cannot be reopened
}

enum RagSourceType {
  CONTAINER // Rag originated from a container
  LOOSE_BALE // Standalone bale (containerId = null)
}

enum RagBaleType {
  RAG
  BALE
  BOTH
}

// =============================================================
// 🌍 1. SUPER ADMIN DOMAIN (No tenantId)
// =============================================================

model Tenant {
  id              String       @id @default(cuid())
  name            String
  companyCode     String       @unique
  currency        String       @default("PKR")
  locale          String       @default("ur-PK")
  status          TenantStatus @default(ACTIVE)
  /// Visible tabs/APIs: RECEIVE, SORT, STOCK, SELL, KHATA, REPORTS, EXPORT, WAREHOUSES, PAYROLL
  enabledModules  String[]     @default(["RECEIVE", "SORT", "STOCK", "SELL", "KHATA"])
  /// 0 = trading only (no sorting), 1 = category only, 2 = category + grade
  sortingStages   Int          @default(2)
  defaultLanguage String       @default("ur")
  /// Set when the owner finished the setup wizard (journey 8); null = show the wizard after sign-in.
  setupCompletedAt DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  users                  User[]
  roles                  Role[]
  categories             Category[]
  rawCategories          RawCategory[]
  grades                 Grade[]
  warehouses             Warehouse[]
  vendors                Vendor[]
  purchaseOrders         PurchaseOrder[]
  containers             Container[]
  rags                   Rag[]
  sortSessions           SortSession[]
  categoryOutputs        CategoryOutput[]
  gradeSessions          GradeSession[]
  gradeOutputs           GradeOutput[]
  repackSessions         RepackSession[]
  repackUnits            RepackUnit[]
  repackInputAllocations RepackInputAllocation[]
  inventoryItems         InventoryItem[]
  sequences              TenantSequence[]

  // Sales
  customers Customer[]
  sales     Sale[]
  payments  Payment[]

  // Waste configuration + line items
  wasteCategories WasteCategory[]
  wasteLineItems  WasteLineItem[]

  @@index([companyCode])
}

/// Deduplicates client retry/sync requests within a tenant and operational scope.
model IdempotencyKey {
  id           String   @id @default(cuid())
  tenantId     String
  scope        String
  key          String
  responseJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, scope, key])
  @@index([tenantId, createdAt])
}

// =============================================================
// 💰 10. SALES DOMAIN
// =============================================================

model Customer {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  phone             String? // WhatsApp number, E.164 (+923001234567)
  city              String?
  openingBalance    Decimal  @default(0) @db.Decimal(14, 2) // udhaar carried from the old register (negative = advance)
  companyName       String?
  billingAddress    String?
  shippingAddress   String?
  contactEmail      String?
  contactPhone      String?
  taxId             String?
  creditLimit       Decimal? @default(0) @db.Decimal(14, 2)
  paymentTerms      String?  @default("PREPAID")
  creditStatus      String?  @default("GOOD_STANDING")
  currencyCode      String?  @default("PKR")
  bankName          String?
  bankAccountNumber String?
  swiftBic          String?
  notes             String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sales    Sale[]
  payments Payment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, phone])
  @@index([contactEmail])
}

model Sale {
  id                   String            @id @default(cuid())
  tenantId             String
  saleNumber           String
  customerId           String
  type                 SaleType          @default(LOCAL)
  paymentMode          PaymentMode
  billToken            String            @unique // unguessable; the public bill link shared on WhatsApp
  status               SaleStatus        @default(DRAFT)
  fulfillmentStatus    FulfillmentStatus @default(PENDING)
  fulfilledAt          DateTime?
  fulfillmentReference String?
  currencyCode         String
  totalAmount          Decimal           @default(0) @db.Decimal(14, 2)
  totalCost            Decimal           @default(0) @db.Decimal(14, 2)
  totalProfit          Decimal           @default(0) @db.Decimal(14, 2)
  issuedAt             DateTime?
  createdBy            String
  billOfLadingNumber   String?
  containerSealNumber  String?
  vesselName           String?
  portOfLoading        String?
  portOfDischarge      String?
  freightForwarder     String?
  destinationCountry   String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  creator  User       @relation("SaleCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lines    SaleLine[]
  payments Payment[]

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([saleNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SaleLine {
  id              String    @id @default(cuid())
  saleId          String
  inventoryItemId String
  unit            StockUnit // what the price is per: kg, bale or piece
  quantity        Decimal   @db.Decimal(14, 2)
  unitPrice       Decimal   @db.Decimal(14, 4)
  lineTotal       Decimal   @db.Decimal(14, 2)
  lineCost        Decimal   @db.Decimal(14, 2)
  profit          Decimal   @db.Decimal(14, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([saleId])
  @@index([inventoryItemId])
}

/// Money received from a customer: against a sale, or on account. Applied to the oldest unpaid sales first.
model Payment {
  id            String        @id @default(cuid())
  tenantId      String
  customerId    String
  saleId        String? // set when paid with a sale; null = on account
  amount        Decimal       @db.Decimal(14, 2)
  method        PaymentMethod @default(CASH)
  reference     String? // bank/Raast/JazzCash transaction id
  attachmentUrl String? // storage key of a receipt screenshot, e.g. local:payments/<tenant>/<id>.jpg
  receivedBy    String? // user id
  receivedAt    DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sale     Sale?    @relation(fields: [saleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@index([saleId])
  @@index([receivedAt])
}

model WasteCategory {
  id                 String        @id @default(cuid())
  tenantId           String
  name               String
  linkedCategoryId   String? // If auto-generated from Category
  unitType           WasteUnitType
  defaultResalePrice Decimal       @default(0) @db.Decimal(14, 4)
  isSystemGenerated  Boolean       @default(false)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  linkedCategory Category?       @relation(fields: [linkedCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  wasteLineItems WasteLineItem[]

  @@unique([tenantId, name])
  @@unique([linkedCategoryId]) // One Category → One auto-generated WasteCategory
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([unitType])
}

model WasteLineItem {
  id              String        @id @default(cuid())
  tenantId        String
  stage           WasteStage
  wasteCategoryId String
  amount          Decimal       @db.Decimal(10, 2)
  unitType        WasteUnitType
  estimatedValue  Decimal       @db.Decimal(14, 4)

  // Source references (exactly one session is used depending on stage)
  sortSessionId  String?
  gradeSessionId String?

  // Traceability chain (denormalized for audit/report joins)
  containerId      String?
  ragId            String?
  categoryOutputId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  wasteCategory  WasteCategory   @relation(fields: [wasteCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sortSession    SortSession?    @relation(fields: [sortSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gradeSession   GradeSession?   @relation(fields: [gradeSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rag            Rag?            @relation(fields: [ragId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  container      Container?      @relation(fields: [containerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  categoryOutput CategoryOutput? @relation(fields: [categoryOutputId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([wasteCategoryId])
  @@index([sortSessionId])
  @@index([gradeSessionId])
  @@index([ragId])
  @@index([containerId])
  @@index([categoryOutputId])
}

model TenantSequence {
  id         String        @id @default(cuid())
  tenantId   String
  scope      SequenceScope
  prefix     String?
  nextNumber Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([tenantId, scope])
  @@index([tenantId])
}

model GlobalConfig {
  id        String @id @default(cuid())
  key       String @unique
  valueJson Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model GlobalCategoryTemplate {
  id                  String @id @default(cuid())
  categoryName        String
  defaultWeightUnit   String @default("KG")
  defaultSortPriority Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryName])
}

// =============================================================
// 👥 2. RBAC DOMAIN
// =============================================================

model User {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  /// Owners and admins sign in with email + password; a munshi may have only a phone + PIN.
  email        String?
  passwordHash String?
  /// WhatsApp/phone in E.164 (+923001234567). Unique across tenants: it is the munshi's login.
  phone             String?   @unique
  /// bcrypt of the 4–6 digit PIN.
  pinHash           String?
  /// Wrong PINs in a row; 5 locks the PIN for 15 minutes (the owner can unlock).
  failedPinAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userRoles UserRole[]

  // Worker/Supervisor relations
  sortSessionsAsWorker       SortSession[]   @relation("SortSessionWorker")
  sortSessionsAsSupervisor   SortSession[]   @relation("SortSessionSupervisor")
  gradeSessionsAsWorker      GradeSession[]  @relation("GradeSessionWorker")
  gradeSessionsAsSupervisor  GradeSession[]  @relation("GradeSessionSupervisor")
  repackSessionsAsWorker     RepackSession[] @relation("RepackSessionWorker")
  repackSessionsAsSupervisor RepackSession[] @relation("RepackSessionSupervisor")

  // Sales
  createdSales Sale[] @relation("SaleCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Permission {
  id    String @id @default(cuid())
  code  String @unique
  name  String
  group String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  rolePermissions RolePermission[]

  @@index([code])
  @@index([group])
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
}

// =============================================================
// ⚙️ 3. CONFIG DOMAIN
// =============================================================

model Category {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sortCategoryBuckets SortCategoryBucket[]
  categoryOutputs     CategoryOutput[]
  repackUnits         RepackUnit[]
  inventoryItems      InventoryItem[]
  linkedWasteCategory WasteCategory? // Auto-generated waste category

  @@unique([tenantId, name])
  @@index([tenantId])
}

model RawCategory {
  id        String      @id @default(cuid())
  tenantId  String
  name      String
  rawType   RagBaleType // RAG or BALE
  sortOrder Int         @default(0)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rags   Rag[]

  @@unique([tenantId, name, rawType])
  @@index([tenantId])
  @@index([rawType])
}

model Grade {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  rank        Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gradeBuckets   GradeBucket[]
  gradeOutputs   GradeOutput[]
  repackUnits    RepackUnit[]
  inventoryItems InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inventoryItems InventoryItem[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

// =============================================================
// 📦 4. PROCUREMENT DOMAIN
// =============================================================

model Vendor {
  id                String     @id @default(cuid())
  tenantId          String
  name              String
  companyName       String?
  vendorType        VendorType @default(SUPPLIER)
  country           String?
  originCountry     String? // Default origin for this supplier's containers
  taxId             String?
  contactPerson     String?
  contactEmail      String?
  contactPhone      String?
  contactInfo       String?
  paymentTerms      String?    @default("NET_30")
  defaultCurrency   String?    @default("PKR")
  remittanceAccount String?
  physicalAddress   String?
  notes             String?
  isActive          Boolean    @default(true)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseOrders PurchaseOrder[]
  containers     Container[]
  rags           Rag[]
  stockItems     InventoryItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([vendorType])
  @@index([name])
}

model PurchaseOrder {
  id        String              @id @default(cuid())
  tenantId  String
  vendorId  String?
  poNumber  String
  poType    PurchaseOrderType
  currency  String              @default("USD")
  totalCost Decimal             @db.Decimal(14, 2)
  budgetCap Decimal?            @db.Decimal(14, 2)
  status    PurchaseOrderStatus @default(OPEN)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  // Relations
  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  vendor     Vendor?     @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  containers Container[]

  @@unique([tenantId, poNumber])
  @@index([tenantId])
  @@index([vendorId])
  @@index([poNumber])
  @@index([status])
}

model Container {
  id                 String          @id @default(cuid())
  tenantId           String
  purchaseOrderId    String? // Optional: purchase orders are an advanced feature
  vendorId           String?
  originCountry      String?
  containerNumber    String
  referenceNumber    String?
  containerType      String?
  eta                DateTime?
  etd                DateTime?
  arrivedAt          DateTime?
  clearedAt          DateTime?
  releasedAt         DateTime?
  grossWeight        Decimal         @db.Decimal(10, 2)
  tareWeight         Decimal?        @db.Decimal(10, 2)
  netWeight          Decimal         @db.Decimal(10, 2)
  billOfLadingNumber String?
  shipmentReference  String?
  shippingLine       String?
  vesselName         String?
  portOfLoading      String?
  portOfDischarge    String?
  forwarder          String?
  notes              String?
  status             ContainerStatus @default(IN_TRANSIT)

  // Gate Weighbridge Scale Variance Audit Fields
  weighbridgeGrossWeight Decimal? @db.Decimal(10, 2)
  weighbridgeTareWeight  Decimal? @db.Decimal(10, 2)
  weighbridgeNetWeight   Decimal? @db.Decimal(10, 2)
  weightVarianceKg       Decimal? @db.Decimal(10, 2)
  weightVariancePct      Decimal? @db.Decimal(5, 2)
  varianceAlertStatus    String?
  /// Purchase price in purchaseCurrency (not a charge). Landed cost = purchaseCost × fxRate (if not PKR) + charges.
  purchaseCost           Decimal  @default(0) @db.Decimal(14, 2)
  purchaseCurrency       String   @default("PKR")
  fxRate                 Decimal  @default(1.0000) @db.Decimal(10, 4)
  /// Stored by the costing engine.
  landedCostPKR          Decimal  @default(0) @db.Decimal(14, 2)
  landedCostPerKg        Decimal? @db.Decimal(14, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  purchaseOrder    PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vendor           Vendor?           @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  containerCharges ContainerCharge[]
  rags             Rag[]

  // Phase 2.5: Downstream traceability (for container-level analytics)
  categoryOutputs CategoryOutput[] // Category outputs traced to this container
  wasteLineItems  WasteLineItem[] // Waste line items linked for audit/reporting

  @@unique([tenantId, containerNumber])
  @@index([tenantId])
  @@index([purchaseOrderId])
  @@index([vendorId])
  @@index([containerNumber])
  @@index([status])
}

model ContainerCharge {
  id          String     @id @default(cuid())
  containerId String
  description String
  amount      Decimal    @db.Decimal(14, 2)
  chargeType  ChargeType
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  container Container @relation(fields: [containerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([containerId])
  @@index([chargeType])
}

model Rag {
  id            String      @id @default(cuid())
  tenantId      String
  containerId   String? // null for loose bale (sourceType = LOOSE_BALE)
  ragCode       String
  ragBaleType   RagBaleType @default(RAG)
  rawCategoryId String?
  vendorId      String?
  originCountry String?
  weightKg      Decimal     @db.Decimal(10, 2)
  /// Price paid for a loose lot bought without a container (null for container lots).
  purchaseCost  Decimal?    @db.Decimal(14, 2)
  /// Container lots: share of the container's landed cost. Loose lots: purchaseCost.
  allocatedCost Decimal     @db.Decimal(14, 2)

  // =============================================================
  // Phase 2.5: Rag/Bale Lifecycle & Source Tracking
  // =============================================================
  // sourceType: Indicates whether this is from a container or a loose bale
  // status: Enforces one-time processing lifecycle
  //         NOT_STARTED -> IN_SORTING -> SORTED
  // =============================================================
  sourceType RagSourceType @default(CONTAINER)
  status     RagStatus     @default(NOT_STARTED)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  container   Container?   @relation(fields: [containerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rawCategory RawCategory? @relation(fields: [rawCategoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  vendor      Vendor?      @relation(fields: [vendorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  // One-to-one with SortSession: Each Rag can only be sorted ONCE
  sortSession SortSession?

  // Downstream traceability relations (Phase 2.5)
  categoryOutputs CategoryOutput[] // Category outputs from this rag
  wasteLineItems  WasteLineItem[] // Waste line items (Stage-1/Stage-2) linked for audit

  @@unique([tenantId, ragCode])
  @@index([tenantId])
  @@index([containerId])
  @@index([rawCategoryId])
  @@index([vendorId])
  @@index([ragCode])
  @@index([ragBaleType])
  @@index([status]) // Index for filtering by status (e.g., WHERE status = 'NOT_STARTED')
  @@index([sourceType]) // Index for filtering by source type
}

// =============================================================
// 🟩 5. SORTING STAGE 1 — CATEGORY SORTING
// =============================================================
// Phase 2.5: Traceability Rules (LOCKED)
// - SortSession MUST reference exactly ONE Rag/Bale
// - ragId is UNIQUE: One Rag = One Sorting Session (one-time processing)
// - All downstream data MUST reference source chain
// =============================================================

model SortSession {
  id       String @id @default(cuid())
  tenantId String

  // =============================================================
  // Phase 2.5: Source Traceability (MANDATORY)
  // =============================================================
  // ragId is UNIQUE: Prevents multiple sessions per Rag/Bale
  // This enforces ONE-TIME PROCESSING per Rag
  // =============================================================
  ragId String @unique // UNIQUE: One Rag can only be sorted ONCE

  workerId          String
  supervisorId      String
  startTime         DateTime   @default(now())
  endTime           DateTime?
  totalInputWeight  Decimal    @db.Decimal(10, 2)
  totalOutputWeight Decimal    @db.Decimal(10, 2)
  wasteWeight       Decimal    @db.Decimal(10, 2)
  status            SortStatus @default(OPEN)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Relations
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  rag                 Rag                  @relation(fields: [ragId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  worker              User                 @relation("SortSessionWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supervisor          User                 @relation("SortSessionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sortCategoryBuckets SortCategoryBucket[]
  wasteLineItems      WasteLineItem[]

  @@index([tenantId])
  @@index([ragId])
  @@index([workerId])
  @@index([supervisorId])
  @@index([status])
}

model SortCategoryBucket {
  id             String   @id @default(cuid())
  sortSessionId  String
  categoryId     String
  outputWeightKg Decimal  @db.Decimal(10, 2)
  outputCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  sortSession     SortSession      @relation(fields: [sortSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryOutputs CategoryOutput[]

  @@unique([sortSessionId, categoryId])
  @@index([sortSessionId])
  @@index([categoryId])
}

model CategoryOutput {
  id                   String  @id @default(cuid())
  tenantId             String
  sortCategoryBucketId String
  categoryId           String
  weightKg             Decimal @db.Decimal(10, 2)
  /// kg already put into bales directly (tenants that sort in one stage). Graded outputs stay 0.
  usedKg               Decimal @default(0) @db.Decimal(10, 2)
  count                Int     @default(0)
  allocatedCost        Decimal @db.Decimal(14, 2)

  // =============================================================
  // Phase 2.5: Traceability Chain (MANDATORY)
  // =============================================================
  // Every downstream entity MUST reference its source chain
  // containerId: Optional (null for loose bale)
  // ragId: REQUIRED - Links back to source Rag/Bale
  // sortSessionId: REQUIRED - Links back to sorting session
  // =============================================================
  containerId   String? // Nullable: null for loose bale origins
  ragId         String // REQUIRED: Source Rag/Bale traceability
  sortSessionId String // REQUIRED: Source session traceability

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant             Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  sortCategoryBucket SortCategoryBucket      @relation(fields: [sortCategoryBucketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category           Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rag                Rag                     @relation(fields: [ragId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  container          Container?              @relation(fields: [containerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  gradeSessions      GradeSession[]
  wasteLineItems     WasteLineItem[]
  baleAllocations    RepackInputAllocation[]

  @@index([tenantId])
  @@index([sortCategoryBucketId])
  @@index([categoryId])
  @@index([ragId]) // Index for rag-level yield analytics
  @@index([containerId]) // Index for container-level yield analytics
  @@index([sortSessionId]) // Index for session traceability
}

// =============================================================
// 🗑️ SORTING WASTE (Phase 2.5 - NEW)
// =============================================================
// Waste output from Sorting Stage 1 with full traceability
// One-to-one relationship with SortSession
// =============================================================

// =============================================================
// 🟨 6. SORTING STAGE 2 — GRADING
// =============================================================

model GradeSession {
  id               String      @id @default(cuid())
  tenantId         String
  categoryOutputId String
  workerId         String
  supervisorId     String
  startTime        DateTime    @default(now())
  endTime          DateTime?
  status           GradeStatus @default(OPEN)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  categoryOutput CategoryOutput  @relation(fields: [categoryOutputId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  worker         User            @relation("GradeSessionWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supervisor     User            @relation("GradeSessionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gradeBuckets   GradeBucket[]
  wasteLineItems WasteLineItem[]

  @@index([tenantId])
  @@index([categoryOutputId])
  @@index([workerId])
  @@index([supervisorId])
  @@index([status])
}

model GradeBucket {
  id             String   @id @default(cuid())
  gradeSessionId String
  gradeId        String
  outputWeightKg Decimal  @db.Decimal(10, 2)
  outputCount    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  gradeSession GradeSession  @relation(fields: [gradeSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grade        Grade         @relation(fields: [gradeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  gradeOutputs GradeOutput[]

  @@unique([gradeSessionId, gradeId])
  @@index([gradeSessionId])
  @@index([gradeId])
}

model GradeOutput {
  id            String  @id @default(cuid())
  tenantId      String
  gradeBucketId String
  gradeId       String
  weightKg      Decimal @db.Decimal(10, 2)
  count         Int     @default(0)
  allocatedCost Decimal @db.Decimal(14, 2)

  // =============================================================
  // Mixed-Source Repack v2: Usage Tracking (MANDATORY)
  // =============================================================
  totalAmount     Decimal             @db.Decimal(10, 2) // Total available (weightKg or count)
  usedAmount      Decimal             @default(0) @db.Decimal(10, 2) // Amount already allocated
  remainingAmount Decimal             @db.Decimal(10, 2) // Computed: totalAmount - usedAmount
  measurementType MeasurementType     @default(WEIGHT) // WEIGHT (kg) or QUANTITY (pcs)
  status          GradingOutputStatus @default(AVAILABLE) // AVAILABLE, PARTIALLY_USED, DEPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gradeBucket GradeBucket @relation(fields: [gradeBucketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grade       Grade       @relation(fields: [gradeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Repack allocations referencing this grading output
  repackAllocations RepackInputAllocation[]

  @@index([tenantId])
  @@index([gradeBucketId])
  @@index([gradeId])
  @@index([status]) // Index for filtering by availability status
  @@index([measurementType]) // Index for filtering by measurement type
}

// =============================================================
// 📦 7. REPACK / BUNDLING DOMAIN
// =============================================================

model RepackSession {
  id           String              @id @default(cuid())
  tenantId     String
  workerId     String
  supervisorId String
  startTime    DateTime            @default(now())
  endTime      DateTime?
  status       RepackSessionStatus @default(OPEN)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // Relations
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  worker      User         @relation("RepackSessionWorker", fields: [workerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supervisor  User         @relation("RepackSessionSupervisor", fields: [supervisorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  repackUnits RepackUnit[]

  @@index([tenantId])
  @@index([workerId])
  @@index([supervisorId])
  @@index([status])
}

model RepackUnit {
  id              String       @id @default(cuid())
  tenantId        String
  repackSessionId String
  categoryId      String?
  gradeId         String?
  unitCode        String
  unitType        UnitType
  weightKg        Decimal      @db.Decimal(10, 2)
  pcsCount        Int          @default(0)
  totalCost       Decimal      @db.Decimal(14, 2)
  status          RepackStatus @default(READY)

  // =============================================================
  // Mixed-Source Repack v2: Allocation Strategy (MANDATORY)
  // =============================================================
  measurementType MeasurementType @default(WEIGHT) // WEIGHT (kg) or QUANTITY (pcs)
  targetAmount    Decimal         @db.Decimal(10, 2) // Target kg or pcs for this unit
  allocationMode  AllocationMode  @default(FIFO) // FIFO (automatic) or MANUAL (user-selected)
  createdBy       String? // User who created this repack unit

  // =============================================================
  // Phase 2.5: Traceability Chain (MANDATORY)
  // =============================================================
  // Every downstream entity MUST reference its source chain
  // containerId: Optional (null for loose bale origins)
  // ragId: REQUIRED - Links back to source Rag/Bale
  // sortSessionId: REQUIRED - Links back to Sorting Stage 1
  // gradeSessionId: Optional - Links to Sorting Stage 2 (if graded)
  // 
  // NOTE: With Mixed-Source v2, these fields represent PRIMARY source.
  // Full traceability is maintained via RepackInputAllocation table.
  // =============================================================
  containerId    String? // Nullable: null for loose bale origins or mixed-source
  ragId          String? // Primary source Rag/Bale traceability
  sortSessionId  String? // Primary source Sorting Stage 1 session
  gradeSessionId String? // Primary source Sorting Stage 2 session (optional)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repackSession  RepackSession   @relation(fields: [repackSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  grade          Grade?          @relation(fields: [gradeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  qrLabel        QRLabel?
  inventoryItems InventoryItem[]

  // Mixed-Source v2: Input allocations (CRITICAL for traceability)
  inputAllocations RepackInputAllocation[]

  @@unique([tenantId, unitCode])
  @@index([tenantId])
  @@index([repackSessionId])
  @@index([categoryId])
  @@index([gradeId])
  @@index([unitCode])
  @@index([status])
  @@index([ragId]) // Index for rag-level analytics
  @@index([containerId]) // Index for container-level analytics
  @@index([sortSessionId]) // Index for session traceability
  @@index([allocationMode]) // Index for allocation mode filtering
  @@index([measurementType]) // Index for measurement type filtering
}

// =============================================================
// 📦 REPACK INPUT ALLOCATION (MIXED-SOURCE v2)
// =============================================================
// This table is the ONLY source of truth for mixed-source repacking.
// Each row represents ONE contribution from a grading output into a repack unit.
// Enables full traceability: RepackUnit → GradingOutput → GradeBucket → 
// GradeSession → CategoryOutput → SortSession → Rag → Container
// =============================================================

model RepackInputAllocation {
  id               String  @id @default(cuid())
  tenantId         String
  repackUnitId     String
  /// Exactly one source is set (DB check constraint): a grade output (2-stage sorting)
  /// or a category output (1-stage sorting).
  gradingOutputId  String?
  categoryOutputId String?

  // =============================================================
  // Traceability Chain (MANDATORY)
  // =============================================================
  // These are denormalized from GradingOutput for query performance
  // but MUST match the source GradingOutput's lineage
  // =============================================================
  containerId String? // Source container (null for loose bale origins)
  ragBaleId   String? // Source rag/bale ID

  // =============================================================
  // Allocation Details (MANDATORY)
  // =============================================================
  amountUsed      Decimal         @db.Decimal(10, 2) // kg or pcs used from this grading output
  measurementType MeasurementType // WEIGHT or QUANTITY (must match repack unit)
  allocatedCost   Decimal         @default(0) @db.Decimal(14, 2) // Proportional cost from grading output

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repackUnit     RepackUnit      @relation(fields: [repackUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  gradingOutput  GradeOutput?    @relation(fields: [gradingOutputId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  categoryOutput CategoryOutput? @relation(fields: [categoryOutputId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([tenantId])
  @@index([repackUnitId])
  @@index([gradingOutputId])
  @@index([categoryOutputId])
  @@index([containerId]) // Index for container-level analytics
  @@index([ragBaleId]) // Index for rag/bale-level analytics
  @@index([createdAt]) // Index for FIFO sorting
}

model QRLabel {
  id           String   @id @default(cuid())
  repackUnitId String   @unique
  qrCode       String   @unique
  generatedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  repackUnit RepackUnit @relation(fields: [repackUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([qrCode])
}

// =============================================================
// 📦 8. INVENTORY DOMAIN
// =============================================================

model InventoryItem {
  id           String          @id @default(cuid())
  tenantId     String
  source       StockSource     @default(PROCESSED)
  repackUnitId String? // set for PROCESSED bales made here; null for bought stock and opened pieces
  categoryId   String?
  gradeId      String? // null for bales from 1-stage sorting (category only)
  vendorId     String? // supplier of PURCHASED stock
  name         String? // e.g. "Jeans A grade bale", "Ladies tops"
  unit         StockUnit
  quantity     Decimal         @db.Decimal(14, 2) // received, in `unit`
  usedQuantity Decimal         @default(0) @db.Decimal(14, 2) // sold or opened, in `unit`
  totalCost    Decimal         @db.Decimal(14, 2) // cost of the whole quantity
  unitCost     Decimal         @db.Decimal(14, 4)
  salePrice    Decimal?        @db.Decimal(14, 2)
  priceTier    String? // pieces opened from a bale, e.g. "300"
  parentItemId String? // the bale these pieces were opened from
  weightKg     Decimal?        @db.Decimal(14, 2)
  pcsCount     Int             @default(0)
  avgCost      Decimal?        @db.Decimal(14, 2) // per kg, when the weight is known
  warehouseId  String? // Optional - can be assigned later
  status       InventoryStatus @default(AVAILABLE)

  // Lineage (denormalised): null for bought stock and loose-lot origins.
  containerId String?
  ragId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  repackUnit     RepackUnit?     @relation(fields: [repackUnitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  category       Category?       @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  grade          Grade?          @relation(fields: [gradeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  vendor         Vendor?         @relation(fields: [vendorId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  parentItem     InventoryItem?  @relation("OpenedPieces", fields: [parentItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pieces         InventoryItem[] @relation("OpenedPieces")
  warehouse      Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stockMovements StockMovement[]

  // Sales
  saleLines SaleLine[]

  @@index([tenantId])
  @@index([tenantId, source, status])
  @@index([repackUnitId])
  @@index([categoryId])
  @@index([gradeId])
  @@index([vendorId])
  @@index([parentItemId])
  @@index([warehouseId])
  @@index([status])
  @@index([ragId]) // Index for rag-level analytics
  @@index([containerId]) // Index for container-level analytics
}

model StockMovement {
  id              String       @id @default(cuid())
  inventoryItemId String
  movementType    MovementType
  quantityKg      Decimal      @db.Decimal(10, 2)
  quantityPcs     Int          @default(0)
  referenceId     String?
  metadataJson    Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relations
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([inventoryItemId])
  @@index([movementType])
  @@index([referenceId])
  @@index([createdAt])
}

// =============================================================
// 🔐 9. AUDIT & REFRESH TOKEN DOMAIN
// =============================================================

model AuditLog {
  id           String   @id @default(cuid())
  tenantId     String?
  userId       String?
  action       String
  entityType   String?
  entityId     String?
  metadataJson Json?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
