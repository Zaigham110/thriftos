# Copy this file to .env and replace every placeholder before starting ThriftOS.
POSTGRES_USER=thriftos
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=thriftos
DATABASE_URL="postgresql://thriftos:replace-with-a-strong-database-password@localhost:5432/thriftos?schema=public"
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_ACCESS_EXPIRES_IN=900s
CORS_ORIGIN=http://localhost:4200

# Seed data is for local/demo environments only. Never enable it in production.
SEED_DATABASE=false
